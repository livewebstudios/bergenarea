---
import Site from '../../layouts/Site.astro';
import PageHead from '../../components/site/PageHead.astro';
import Reading from '../../components/site/Reading.astro';
import { readings } from '../../content/pages';
const r = readings.spad;
---
<Site title={`${r.h1} | Bergen Area of Narcotics Anonymous`} description={`${r.h1}: today's reading from NA World Services.`} crumbs={[{ name: r.h1, path: 'spad/' }]}>
  <PageHead h1={r.h1} scene="keytag" seed={31} />
  <section class="d1-band grain">
    <div class="wrap">
      <Reading kind="spad" fallback={r.fallback} />
    </div>
  </section>
</Site>
