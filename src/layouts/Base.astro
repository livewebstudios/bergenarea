---
import '../styles/tokens.css';
import '../styles/base.css';
import { href } from '../lib/href';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
}
const { title, description, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(href('img/og.png'), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Bergen Area of Narcotics Anonymous',
    url: 'https://bergenarea.org/',
    email: 'info@bergenarea.org',
    telephone: '+1-800-992-0401',
    areaServed: 'Bergen County, NJ',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Bergen Area of Narcotics Anonymous',
    url: 'https://bergenarea.org/',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- CANONICAL: preview build. Confirm https://bergenarea.org/ paths before go-live. -->
    <link rel="canonical" href={canonical} />
    <!-- REVIEW GATE: every route is noindex until launch. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- GA4 placeholder -->
    <!-- GA4: replace G-XXXXXXXXXX -->
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
