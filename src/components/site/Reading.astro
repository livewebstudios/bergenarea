---
/* Today's reading from NA World Services, fetched fresh by a Netlify Function
   (netlify/functions/reading.mjs). Nothing is stored in the repo. If the fetch fails,
   the page offers a link to na.org instead. */
interface Props { kind: 'jft' | 'spad'; fallback: string }
const { kind, fallback } = Astro.props;
---
<div class="rd" data-reading={kind} data-endpoint={`/.netlify/functions/reading?kind=${kind}`} aria-live="polite" aria-busy="true">
  <p class="rd__loading">…</p>
  <p class="rd__fail" hidden><a class="d1-btn" href={fallback} target="_blank" rel="noopener noreferrer">na.org</a></p>
  <article class="rd__body" hidden>
    <p class="rd__date" data-f="date"></p>
    <h2 class="d1-display rd__title" data-f="title"></h2>
    <p class="rd__page" data-f="page"></p>
    <blockquote class="rd__quote"><p data-f="quote"></p><footer data-f="source"></footer></blockquote>
    <div class="rd__content" data-f="content"></div>
    <p class="rd__thought" data-f="thought"></p>
    <p class="rd__copy" data-f="copyright"></p>
  </article>
</div>

<script>
  interface Reading { date?: string; title?: string; page?: string; quote?: string; source?: string; content?: string[]; thought?: string; copyright?: string }
  document.querySelectorAll<HTMLElement>('[data-reading]').forEach(async (box) => {
    const fail = () => { box.querySelector('.rd__loading')?.remove(); box.querySelector<HTMLElement>('.rd__fail')!.hidden = false; box.setAttribute('aria-busy', 'false'); };
    try {
      const res = await fetch(box.dataset.endpoint!, { headers: { accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      const r: Reading = await res.json();
      if (!r.title || !r.content?.length) throw new Error('empty');
      const body = box.querySelector<HTMLElement>('.rd__body')!;
      body.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => {
        const key = el.dataset.f as keyof Reading;
        if (key === 'content') {
          el.replaceChildren(...(r.content ?? []).map((t) => Object.assign(document.createElement('p'), { textContent: t })));
        } else {
          el.textContent = (r[key] as string | undefined) ?? '';
          el.hidden = !el.textContent;
        }
      });
      box.querySelector('.rd__loading')?.remove();
      body.hidden = false;
      box.setAttribute('aria-busy', 'false');
    } catch {
      fail();
    }
  });
</script>
